# Application
NODE_ENV=development
PORT=3000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger (disabled automatically in production unless set to true)
SWAGGER_ENABLED=true

# PostgreSQL (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=akanpay-db

# Schema: use migrations in shared/CI environments; true is convenient for solo local dev
DB_SYNC=false
DB_MIGRATIONS_RUN=false

# JWT — use long random strings (min 32 characters)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=600s
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
